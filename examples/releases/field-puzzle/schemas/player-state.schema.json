{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field.player-state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempts",
    "visitedCheckpoints",
    "puzzleSolved",
    "firstCheckpoint",
    "puzzleAnswer",
    "secondCheckpoint",
    "maximumObservationAgeMs"
  ],
  "properties": {
    "attempts": { "type": "integer", "minimum": 0 },
    "visitedCheckpoints": {
      "type": "array",
      "items": { "enum": ["first-checkpoint", "second-checkpoint"] },
      "uniqueItems": true
    },
    "puzzleSolved": { "type": "boolean" },
    "firstCheckpoint": { "$ref": "#/$defs/checkpoint" },
    "puzzleAnswer": { "type": "string", "minLength": 1 },
    "secondCheckpoint": { "$ref": "#/$defs/checkpoint" },
    "maximumObservationAgeMs": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "latitude", "longitude", "radiusMeters", "maximumAccuracyMeters"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusMeters": { "type": "number", "exclusiveMinimum": 0 },
        "maximumAccuracyMeters": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
