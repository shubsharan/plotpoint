{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field.advance-outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["result"],
  "properties": {
    "result": {
      "enum": [
        "advanced",
        "incorrect",
        "permission-denied",
        "unavailable",
        "stale",
        "inaccurate",
        "outside",
        "wrong-phase"
      ]
    }
  }
}
