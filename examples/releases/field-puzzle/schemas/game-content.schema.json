{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field.game-content",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "firstCheckpoint", "puzzle", "secondCheckpoint", "maximumObservationAgeMs"],
  "properties": {
    "title": { "type": "string" },
    "maximumObservationAgeMs": { "type": "integer", "minimum": 1 },
    "puzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "answer"],
      "properties": { "prompt": { "type": "string" }, "answer": { "type": "string" } }
    },
    "firstCheckpoint": { "$ref": "#/$defs/checkpoint" },
    "secondCheckpoint": { "$ref": "#/$defs/checkpoint" }
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "latitude", "longitude", "radiusMeters", "maximumAccuracyMeters"],
      "properties": {
        "name": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusMeters": { "type": "number", "exclusiveMinimum": 0 },
        "maximumAccuracyMeters": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
