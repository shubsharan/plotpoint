  "schemas": [
    { "id": "field.advance-outcome.v1", "path": "schemas/advance-outcome.schema.json" },
    { "id": "field.advance-payload.v1", "path": "schemas/advance-payload.schema.json" },
    { "id": "field.game-content.v1", "path": "schemas/game-content.schema.json" }
