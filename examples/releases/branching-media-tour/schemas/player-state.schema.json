{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour.player-state",
  "type": "object",
  "additionalProperties": false,
  "required": ["currentScene", "visitedScenes"],
  "properties": {
    "currentScene": { "type": "string", "minLength": 1 },
    "visitedScenes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
