{
  "projectFormatVersion": 1,
  "environment": "web",
  "hostApi": { "major": 1, "minimumMinor": 1 },
  "application": {
    "definition": { "source": "src/application.ts", "export": "tourApplication" },
    "components": ["tour.media-panel", "tour.scene-navigator"]
  },
  "aggregateModels": [
    {
      "id": "tour.player",
      "authority": "local",
      "kind": "player",
      "stateSchema": "tour.player-state",
      "initializationSchema": "tour.initialization",
      "initializer": { "source": "src/initial-state.ts", "export": "initializeTour" },
      "events": [
        { "type": "tour.media-requested", "schema": "tour.media-requested-event" },
        { "type": "tour.scene-chosen", "schema": "tour.scene-chosen-event" }
      ],
      "effects": [{ "type": "tour.play-audio", "schema": "tour.play-audio-effect" }]
    }
  ],
  "commands": [
    {
      "id": "tour.choose-scene",
      "type": "choose-scene",
      "aggregateModel": "tour.player",
      "payloadSchema": "tour.choose-scene-payload",
      "outcomeSchema": "tour.choose-scene-outcome",
      "execution": "local",
      "definition": { "source": "src/commands/choose-scene.ts", "export": "chooseSceneCommand" }
    },
    {
      "id": "tour.play-media",
      "type": "play-media",
      "aggregateModel": "tour.player",
      "payloadSchema": "tour.play-media-payload",
      "outcomeSchema": "tour.play-media-outcome",
      "execution": "local",
      "definition": { "source": "src/commands/play-media.ts", "export": "playMediaCommand" }
    }
  ],
  "schemas": [
    { "id": "tour.player-state", "path": "schemas/player-state.schema.json" },
    { "id": "tour.initialization", "path": "schemas/initialization.schema.json" },
    {
      "id": "tour.choose-scene-outcome",
      "path": "schemas/choose-scene-outcome.schema.json"
    },
    {
      "id": "tour.choose-scene-payload",
      "path": "schemas/choose-scene-payload.schema.json"
    },
    { "id": "tour.media-content", "path": "schemas/media-content.schema.json" },
    {
      "id": "tour.media-requested-event",
      "path": "schemas/media-requested-event.schema.json"
    },
    { "id": "tour.play-audio-effect", "path": "schemas/play-audio-effect.schema.json" },
    {
      "id": "tour.play-media-outcome",
      "path": "schemas/play-media-outcome.schema.json"
    },
    {
      "id": "tour.play-media-payload",
      "path": "schemas/play-media-payload.schema.json"
    },
    { "id": "tour.scene-chosen-event", "path": "schemas/scene-chosen-event.schema.json" },
    { "id": "tour.scene-content", "path": "schemas/scene-content.schema.json" }
  ],
  "progressions": [
    {
      "id": "tour.branching-route",
      "aggregateModel": "tour.player",
      "definition": { "source": "src/progression/route.ts", "export": "routeProgression" }
    }
  ],
  "components": [
    {
      "id": "tour.media-panel",
      "implementation": { "source": "src/components/media-panel.ts", "export": "MediaPanel" },
      "commands": ["tour.play-media"],
      "content": ["tour.media.river"],
      "assets": ["tour.audio.river"],
      "capabilities": [{ "id": "plotpoint.media.audio", "major": 1, "minimumMinor": 0 }]
    },
    {
      "id": "tour.scene-navigator",
      "implementation": {
        "source": "src/components/scene-navigator.ts",
        "export": "SceneNavigator"
      },
      "commands": ["tour.choose-scene"],
      "content": ["tour.scene.garden", "tour.scene.harbor"],
      "assets": ["tour.map.overview"],
      "capabilities": [{ "id": "plotpoint.location.foreground", "major": 1, "minimumMinor": 1 }]
    }
  ],
  "content": [
    {
      "id": "tour.media.river",
      "path": "content/river-media.json",
      "schema": { "id": "tour.media-content" }
    },
    {
      "id": "tour.scene.garden",
      "path": "content/garden.json",
      "schema": { "id": "tour.scene-content" }
    },
    {
      "id": "tour.scene.harbor",
      "path": "content/harbor.json",
      "schema": { "id": "tour.scene-content" }
    }
  ],
  "assets": [
    {
      "id": "tour.audio.river",
      "path": "assets/river-audio.txt",
      "releasePath": "assets/river-audio.txt"
    },
    {
      "id": "tour.map.overview",
      "path": "assets/tour-map.svg",
      "releasePath": "assets/tour-map.svg"
    }
  ]
}
