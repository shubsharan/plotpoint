{
  "projectFormatVersion": 1,
  "environment": "web",
  "hostApi": { "major": 1, "minimumMinor": 0 },
  "application": {
    "definition": { "source": "src/application.ts", "export": "minimalApplication" },
    "components": ["minimal.puzzle-card"]
  },
  "aggregateModels": [
    {
      "id": "minimal.player",
      "authority": "local",
      "kind": "player",
      "stateSchema": "minimal.player-state",
      "initializationSchema": "minimal.puzzle-content",
      "initializer": { "source": "src/initial-state.ts", "export": "initializeMinimal" },
      "initializationContent": "minimal.puzzle-data",
      "events": [],
      "effects": []
    }
  ],
  "commands": [
    {
      "id": "minimal.solve",
      "type": "solve",
      "execution": "local",
      "definition": { "source": "src/commands/solve.ts", "export": "solveCommand" },
      "aggregateModel": "minimal.player",
      "payloadSchema": "minimal.solve-payload",
      "outcomeSchema": "minimal.solve-outcome"
    }
  ],
  "schemas": [
    { "id": "minimal.player-state", "path": "schemas/player-state.schema.json" },
    { "id": "minimal.puzzle-content", "path": "schemas/puzzle-content.schema.json" },
    { "id": "minimal.solve-outcome", "path": "schemas/solve-outcome.schema.json" },
    { "id": "minimal.solve-payload", "path": "schemas/solve-payload.schema.json" }
  ],
  "progressions": [
    {
      "id": "minimal.puzzle",
      "aggregateModel": "minimal.player",
      "definition": { "source": "src/progression/main.ts", "export": "puzzleProgression" }
    }
  ],
  "components": [
    {
      "id": "minimal.puzzle-card",
      "implementation": { "source": "src/components/puzzle.ts", "export": "PuzzleCard" },
      "commands": ["minimal.solve"],
      "content": ["minimal.puzzle-data"],
      "assets": ["minimal.clue-image"],
      "capabilities": []
    }
  ],
  "content": [
    {
      "id": "minimal.puzzle-data",
      "path": "content/puzzle.json",
      "schema": { "id": "minimal.puzzle-content" }
    }
  ],
  "assets": [
    {
      "id": "minimal.clue-image",
      "path": "assets/clue.svg",
      "releasePath": "assets/clue.svg"
    }
  ]
}
