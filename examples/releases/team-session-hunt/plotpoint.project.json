{
  "projectFormatVersion": 1,
  "environment": "web",
  "hostApi": { "major": 1, "minimumMinor": 2 },
  "entries": {
    "logic": { "source": "src/logic.ts", "export": "logic" },
    "presentation": { "source": "src/presentation.ts", "export": "presentation" }
  },
  "commands": [
    {
      "id": "hunt.advance-round.v1",
      "type": "advance-round",
      "definition": { "source": "src/commands/advance-round.ts", "export": "advanceRoundCommand" },
      "aggregateSchema": "hunt.session-state.v1",
      "payloadSchema": "hunt.advance-round-payload.v1",
      "outcomeSchema": "hunt.advance-round-outcome.v1"
    },
    {
      "id": "hunt.solve-clue.v1",
      "type": "solve-clue",
      "definition": { "source": "src/commands/solve-clue.ts", "export": "solveClueCommand" },
      "aggregateSchema": "hunt.team-state.v1",
      "payloadSchema": "hunt.solve-clue-payload.v1",
      "outcomeSchema": "hunt.solve-clue-outcome.v1"
    }
  ],
  "aggregateSchemas": [
    {
      "id": "hunt.session-state.v1",
      "kind": "session",
      "version": 1,
      "path": "schemas/session-state.schema.json"
    },
    {
      "id": "hunt.team-state.v1",
      "kind": "team",
      "version": 1,
      "path": "schemas/team-state.schema.json"
    }
  ],
  "schemas": [
    { "id": "hunt.advance-round-outcome.v1", "path": "schemas/advance-round-outcome.schema.json" },
    { "id": "hunt.advance-round-payload.v1", "path": "schemas/advance-round-payload.schema.json" },
    { "id": "hunt.clue-content.v1", "path": "schemas/clue-content.schema.json" },
    { "id": "hunt.round-content.v1", "path": "schemas/round-content.schema.json" },
    { "id": "hunt.solve-clue-outcome.v1", "path": "schemas/solve-clue-outcome.schema.json" },
    { "id": "hunt.solve-clue-payload.v1", "path": "schemas/solve-clue-payload.schema.json" }
  ],
  "progressions": [
    {
      "id": "hunt.session-rounds.v1",
      "version": 1,
      "kind": "session",
      "definition": {
        "source": "src/progression/session-rounds.ts",
        "export": "sessionRoundsProgression"
      },
      "aggregateSchema": "hunt.session-state.v1",
      "commands": ["hunt.advance-round.v1"],
      "content": ["hunt.round-rules.v1"],
      "components": ["hunt.session-console.v1"]
    },
    {
      "id": "hunt.team-route.v1",
      "version": 1,
      "kind": "team",
      "definition": { "source": "src/progression/team-route.ts", "export": "teamRouteProgression" },
      "aggregateSchema": "hunt.team-state.v1",
      "commands": ["hunt.solve-clue.v1"],
      "content": ["hunt.clue-pack.v1"],
      "components": ["hunt.clue-board.v1"]
    }
  ],
  "components": [
    {
      "id": "hunt.clue-board.v1",
      "implementation": { "source": "src/components/clue-board.ts", "export": "ClueBoard" },
      "commands": ["hunt.solve-clue.v1"],
      "content": ["hunt.clue-pack.v1"],
      "assets": ["hunt.map.city.v1"],
      "capabilities": [
        { "id": "plotpoint.location.foreground", "major": 1, "minimumMinor": 2 },
        { "id": "plotpoint.session.presence", "major": 1, "minimumMinor": 0 }
      ]
    },
    {
      "id": "hunt.session-console.v1",
      "implementation": {
        "source": "src/components/session-console.ts",
        "export": "SessionConsole"
      },
      "commands": ["hunt.advance-round.v1"],
      "content": ["hunt.round-rules.v1"],
      "assets": ["hunt.audio.round.v1"],
      "capabilities": [
        { "id": "plotpoint.media.audio", "major": 1, "minimumMinor": 0 },
        { "id": "plotpoint.session.presence", "major": 1, "minimumMinor": 1 }
      ]
    }
  ],
  "content": [
    { "id": "hunt.clue-pack.v1", "path": "content/clues.json", "schema": "hunt.clue-content.v1" },
    {
      "id": "hunt.round-rules.v1",
      "path": "content/rounds.json",
      "schema": "hunt.round-content.v1"
    }
  ],
  "assets": [
    {
      "id": "hunt.audio.round.v1",
      "path": "assets/round-chime.txt",
      "releasePath": "assets/round-chime.txt"
    },
    {
      "id": "hunt.map.city.v1",
      "path": "assets/city-map.svg",
      "releasePath": "assets/city-map.svg"
    }
  ]
}
