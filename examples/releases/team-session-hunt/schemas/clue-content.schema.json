{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hunt.clue-content.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["clues", "mapAssetId"],
  "properties": {
    "mapAssetId": { "const": "hunt.map.city.v1" },
    "clues": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clueId", "prompt", "zone"],
        "properties": {
          "clueId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "zone": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
