{
  "projectFormatVersion": 1,
  "environment": "web",
  "hostApi": { "major": 1, "minimumMinor": 1 },
  "application": {
    "definition": { "source": "src/presentation.ts", "export": "application" },
    "components": []
  },
  "aggregateModels": [
    {
      "id": "minimal.player",
      "authority": "local",
      "kind": "player",
      "stateSchema": "minimal.player-state",
      "initializationSchema": "minimal.initialization",
      "initializer": { "source": "src/logic.ts", "export": "initializePlayer" },
      "events": [],
      "effects": []
    },
    {
      "id": "shared.team",
      "authority": "server",
      "kind": "team",
      "stateSchema": "minimal.player-state",
      "initializationSchema": "minimal.initialization",
      "events": [],
      "effects": []
    }
  ],
  "commands": [
    {
      "id": "shared.unselected",
      "type": "discover",
      "execution": "trusted-mechanic",
      "aggregateModel": "shared.team",
      "payloadSchema": "minimal.initialization",
      "outcomeSchema": "minimal.initialization"
    }
  ],
  "schemas": [
    { "id": "minimal.initialization", "path": "schemas/initialization.schema.json" },
    { "id": "minimal.player-state", "path": "schemas/player-state.schema.json" }
  ],
  "progressions": [],
  "components": [],
  "content": [
    {
      "id": "shared.configuration",
      "path": "content/puzzle.json",
      "schema": { "id": "minimal.initialization" }
    }
  ],
  "assets": [],
  "trustedMechanic": {
    "id": "plotpoint.location.target-discovery",
    "aggregateModel": "shared.team",
    "commands": [],
    "configuration": "shared.configuration",
    "projectionSchema": { "id": "minimal.player-state" },
    "capabilities": []
  }
}
