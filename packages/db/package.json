{
  "name": "@plotpoint/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations, transactions, repositories, and durable outbox persistence.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project db"
  },
  "dependencies": {
    "@plotpoint/protocol": "workspace:*",
    "@plotpoint/runtime": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@plotpoint/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.20.3",
    "vitest": "^4.1.0"
  }
}
