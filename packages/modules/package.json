{
  "name": "@plotpoint/modules",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Plotpoint mechanics and their runtime adapters.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project modules"
  },
  "dependencies": {
    "@plotpoint/protocol": "workspace:*",
    "@plotpoint/runtime": "workspace:*"
  },
  "devDependencies": {
    "@plotpoint/typescript-config": "workspace:*",
    "vitest": "^4.1.0"
  }
}
