{
  "name": "@plotpoint/api",
  "version": "0.0.0",
  "private": true,
  "description": "Plotpoint platform HTTP and synchronization APIs.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "node dist/index.js",
    "test": "vitest run --config ../../vitest.config.ts --project api"
  },
  "dependencies": {
    "@plotpoint/db": "workspace:*",
    "@plotpoint/modules": "workspace:*",
    "@plotpoint/protocol": "workspace:*",
    "@plotpoint/runtime": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@plotpoint/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.20.3",
    "vitest": "^4.1.0"
  }
}
