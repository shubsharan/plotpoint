{
  "name": "@plotpoint/player",
  "version": "0.0.0",
  "private": true,
  "description": "Plotpoint Loop 1 mobile host and trusted web runtime.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "android": "expo run:android",
    "build": "tsc -p tsconfig.json --noEmit",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts --project player",
    "test:watch": "vitest --config ../../vitest.config.ts --project player"
  },
  "dependencies": {
    "@plotpoint/protocol": "workspace:*",
    "@plotpoint/runtime": "workspace:*",
    "ajv": "8.18.0",
    "expo": "~57.0.9",
    "expo-camera": "~56.0.8",
    "expo-file-system": "~56.0.8",
    "expo-location": "~56.0.22",
    "expo-sharing": "~56.0.23",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
